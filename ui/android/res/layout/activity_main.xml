<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen, top to bottom:
    header        ROTOS + link chip (searching / connected / reconnecting)
    where to      destination field, Google Maps button, recent places
    progress      planning / map transfer (hidden when idle)
    route         Google map or the ROTOS map preview, distance / time / turns
    ride          remaining, ETA, speed (only while riding)
    options       call alerts
    advanced      collapsible: demo, sample route, simulator link, origin, logs
    action bar    Start ride / Stop ride (fixed at the bottom)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Rotos.Brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textAppearance="@style/TextAppearance.Rotos.Caption" />
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/linkChip"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_idle"
            app:chipIcon="@drawable/ic_bluetooth"
            app:chipIconTint="@color/ctp_overlay1" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- connection: only when the rider switches it on -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/connectIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/ctp_overlay1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connect_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:id="@+id/connectStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connect_off"
                            android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/connectSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- where to -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/gmaps_title"
                        android:textAppearance="@style/TextAppearance.Rotos.CardTitle"
                        app:drawableStartCompat="@drawable/ic_map"
                        app:drawableTint="@color/ctp_mauve" />

                    <TextView
                        android:id="@+id/mirrorStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ctp_subtext1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMirrorAccess"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/mirror_allow"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/goingTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_going_to"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ctp_text"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_place"
                        app:drawableTint="@color/ctp_mauve" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleMaps"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginTop="6dp"
                        android:text="@string/open_google_maps"
                        app:icon="@drawable/ic_map" />

                    <TextView
                        android:id="@+id/destNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/share_hint"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:text="@string/recent_shared"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_history"
                        app:drawableTint="@color/ctp_overlay1" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/recentChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- hero: what ROTOS is doing, with an illustration (idle only) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="120dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/illus_rotos" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hero_title"
                            android:textAppearance="@style/TextAppearance.Rotos.CardTitle" />

                        <TextView
                            android:id="@+id/heroBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/hero_steps"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/ctp_subtext1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- progress -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/progressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ctp_mauve_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/progressTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Rotos.CardTitle" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        app:indicatorColor="@color/ctp_mauve"
                        app:trackColor="@color/ctp_surface0"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/progressDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- error -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/errorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ctp_red_container">

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/ctp_text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ride -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rideCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ctp_sky_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/riding"
                        android:textAppearance="@style/TextAppearance.Rotos.CardTitle"
                        app:drawableStartCompat="@drawable/ic_navigation"
                        app:drawableTint="@color/ctp_sapphire" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/Rotos.Stat">

                            <TextView
                                android:id="@+id/rideLeft"
                                style="@style/Rotos.StatBig"
                                android:text="—" />

                            <TextView
                                style="@style/Rotos.StatLabel"
                                android:text="@string/km_left" />
                        </LinearLayout>

                        <LinearLayout style="@style/Rotos.Stat">

                            <TextView
                                android:id="@+id/rideEta"
                                style="@style/Rotos.StatBig"
                                android:text="—" />

                            <TextView
                                style="@style/Rotos.StatLabel"
                                android:text="@string/arrival" />
                        </LinearLayout>

                        <LinearLayout style="@style/Rotos.Stat">

                            <TextView
                                android:id="@+id/rideSpeed"
                                style="@style/Rotos.StatBig"
                                android:text="—" />

                            <TextView
                                style="@style/Rotos.StatLabel"
                                android:text="@string/kmh" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rideFlags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- route -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/routeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:text="@string/map_on_rotos"
                            android:textAppearance="@style/TextAppearance.Rotos.CardTitle"
                            app:drawableStartCompat="@drawable/ic_route"
                            app:drawableTint="@color/ctp_mauve" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/routeSource"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_preview"
                        android:clipToOutline="true">

                        <com.google.android.gms.maps.MapView
                            android:id="@+id/mapView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/preview_desc"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/Rotos.Stat">

                            <TextView
                                android:id="@+id/routeKm"
                                style="@style/Rotos.StatValue" />

                            <TextView
                                android:id="@+id/routeKmLabel"
                                style="@style/Rotos.StatLabel"
                                android:text="@string/km" />
                        </LinearLayout>

                        <LinearLayout style="@style/Rotos.Stat">

                            <TextView
                                android:id="@+id/routeTime"
                                style="@style/Rotos.StatValue" />

                            <TextView
                                android:id="@+id/routeTimeLabel"
                                style="@style/Rotos.StatLabel"
                                android:text="@string/minutes" />
                        </LinearLayout>

                        <LinearLayout style="@style/Rotos.Stat">

                            <TextView
                                android:id="@+id/routeTurns"
                                style="@style/Rotos.StatValue" />

                            <TextView
                                android:id="@+id/routeTurnsLabel"
                                style="@style/Rotos.StatLabel"
                                android:text="@string/turns" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/routeFlyover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- options -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_call"
                            app:tint="@color/ctp_green" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/call_alerts"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/call_alerts_desc"
                                android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/callAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_notify"
                            app:tint="@color/ctp_mauve" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notify_alerts"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notify_alerts_desc"
                                android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/notifyAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Google usage (UsageGuard caps) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/usageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/usageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usage_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:id="@+id/usageBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption" />

                    <TextView
                        android:id="@+id/usageNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Rotos.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- advanced -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/advancedHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/ctp_overlay1" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/advanced"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <ImageView
                            android:id="@+id/advancedChevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_expand"
                            app:tint="@color/ctp_overlay1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/advancedBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/demo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/demo_ride" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sample"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_route" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:hint="@string/origin_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/origin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/link"
                            android:textAppearance="@style/TextAppearance.Rotos.Caption" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/linkGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:checkedButton="@+id/linkBle"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/linkBle"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/link_ble" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/linkTcp"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/link_tcp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:hint="@string/host_port">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/hostPort"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:text="10.0.2.2:7400" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:hint="@string/speedup">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/speedup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:maxLines="1"
                                    android:text="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlan"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/preview_route" />

                        <TextView
                            android:id="@+id/mapNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/no_key_note"
                            android:textAppearance="@style/TextAppearance.Rotos.Caption" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.Rotos.Mono"
                            android:textIsSelectable="true" />

                        <TextView
                            android:id="@+id/log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextAppearance.Rotos.Mono"
                            android:textIsSelectable="true"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ctp_mantle"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/start_ride"
            android:textSize="17sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
